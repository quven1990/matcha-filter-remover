{
  "name": "matcha-filter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy out --project-name matcha-filter && npm run indexnow",
    "indexnow": "node scripts/indexnow.mjs",
    "samples:list": "wrangler d1 execute matcha-filter-samples --remote --command \"SELECT id, mode, media_type, width, height, byte_size, created_at FROM samples ORDER BY created_at DESC LIMIT 30\"",
    "samples:get": "node scripts/export-sample.mjs"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.0",
    "wrangler": "^4.107.0"
  }
}
